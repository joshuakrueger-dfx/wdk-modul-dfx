# Example application configuration; the library itself does not read environment variables.
DFX_ENVIRONMENT=sandbox
DFX_WALLET=
DFX_NETWORK=ethereum

# Sandbox integration tests only; opt in explicitly. The test ignores DFX_ENVIRONMENT.
DFX_INTEGRATION=0
DFX_TEST_CRYPTO_ASSET=USDT
DFX_TEST_FIAT_CURRENCY=CHF
# Smallest units: 100 CHF and 100 USDT (6 decimals).
DFX_TEST_FIAT_AMOUNT=10000
DFX_TEST_CRYPTO_AMOUNT=100000000
# Optional absolute path to a local JS module default-exporting { getAddress, sign }.
# Authenticated tests call POST /v1/auth: the first call for an unknown address
# permanently creates a sandbox DFX user (address, IP and optional DFX_WALLET).
# Public catalog and quote tests do not write data.
DFX_TEST_ACCOUNT_MODULE=
# Required with the account module for the transaction-detail test.
DFX_TEST_TRANSACTION_UID=
