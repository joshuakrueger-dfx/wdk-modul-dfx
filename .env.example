# Example application configuration; the library itself does not read environment variables.
DFX_ENVIRONMENT=sandbox
DFX_WALLET=
DFX_NETWORK=ethereum

# Unit and integration tests need no environment variables. DFX_INTEGRATION_ORIGIN is set
# internally by tests/integration/setup.js to the local replay server; do not set it.

# Optional variables of the e2e probes under e2e/ (details and side effects: e2e/README.md).
# DFX_ENV=sandbox                        # live matrix, widget check, native quotes: sandbox or production
# PICK=ethereum-buy,ethereum-sell        # widget check: selection keys
# URLS=out/e2e-urls-sandbox.json         # widget check: alternative URL file
# WALLET_SIM_PORT=4748                   # wallet simulator port (journeys and manual use)
# PORT=4748                              # wallet simulator port when started directly
# WALLET_SIM_ENV=sandbox                 # wallet simulator: sandbox or production
# WALLET_SIM_SEED_FILE=                  # wallet simulator: prepared seed file (0600)
# WALLET_SIM_ORDERS_FILE=                # wallet simulator: persisted order metadata
# STATE_DIR=                             # real purchase probe: state directory
# AMOUNT_EUR=                            # real purchase probe: amount in EUR
# DFX_LOCAL_API=http://localhost:3020    # local full stack: API origin
# DFX_LOCAL_APP=http://localhost:3021    # local full stack: app origin
# DFX_LOCAL_DB_CONTAINER=dfx-e2e-wdk2-db-1
# DFX_LOCAL_API_CONTAINER=dfx-e2e-wdk2-api-1
# OBSERVE_MINUTES=15                     # lifecycle probe: observation window per step
# LIFECYCLE_SCENARIOS=buyA,buyB,sell     # lifecycle probe: scenario selection
# E2E_EVM_DEPOSIT_SEED=                  # local full stack: deposit seed, read from the API container if unset; never print it
# ANVIL_PORT=8547                        # deployed ERC-4337 probe: anvil port
